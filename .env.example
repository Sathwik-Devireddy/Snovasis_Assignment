PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Runtime role (raw pg money path + Prisma routine path — same DB, same role; ADR-005)
DATABASE_URL=postgresql://ledgerline_app:CHANGE_ME_APP_PASSWORD@localhost:15432/balancevault

# Owner role (migrations/DDL only — never the app's runtime connection)
DATABASE_URL_OWNER=postgresql://ledgerline_owner:CHANGE_ME_OWNER_PASSWORD@localhost:15432/balancevault

# Bootstrap superuser (creates the two roles; used only by db:migrate:bootstrap)
DATABASE_URL_BOOTSTRAP=postgresql://balancevault_bootstrap:CHANGE_ME_BOOTSTRAP_PASSWORD@localhost:15432/balancevault

# compose-level bootstrap password (docker compose reads this file automatically)
POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD

# Runtime role creation passwords (used by migration 0001 when run as bootstrap)
OWNER_ROLE_PASSWORD=CHANGE_ME_OWNER_PASSWORD
APP_ROLE_PASSWORD=CHANGE_ME_APP_PASSWORD

# Redis — rate limiting only; never financial state. Local dev: no password, loopback-only.
REDIS_URL=redis://localhost:16379

# Sessions (ADR-006): opaque cookie token TTL; Secure flag is mandatory in production
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false

# Rate limits (Redis-backed fixed windows; fail-soft on Redis outage — T-060)
RATE_LIMIT_REGISTER_LIMIT=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_MONEY_LIMIT=60
RATE_LIMIT_MONEY_WINDOW_SECONDS=60

# First-admin bootstrap host command (P5.9). Generate strong values per
# environment; plaintext never enters the repository (T-015/T-034).
# BOOTSTRAP_ADMIN_EMAIL=admin@balancevault.local
# BOOTSTRAP_ADMIN_PASSWORD=<host-generated 16+ chars>

# rotate-admin-credentials host command (§C.1.3): operator claim comes from
# the host env only; CI refusals are the default (BOOTSTRAP_ALLOW_ROTATION_CI).
# LEDGERLINE_OPERATOR_ID=<operator-session-id>
# ROTATE_ADMIN_EMAIL=
# ROTATE_ADMIN_PASSWORD=

# Postgres/Redis host-port mapping used by docker-compose.yml (127.0.0.1 only)
PG_HOST_PORT=15432
REDIS_HOST_PORT=16379

# Web frontend -> API internal origin (master-stabilisation 4.1).
# Server-side only: NEVER expose this through a NEXT_PUBLIC_* variable (the
# internal service address must not leak to the browser; browser traffic always
# goes through the same-origin /api path).
#   local dev        : http://localhost:4000 (default when unset)
#   docker compose   : http://api:4000
#   production       : REQUIRED — `next build`/`next start` FAIL FAST with a
#                       clear error when it is missing or malformed, instead of
#                       silently proxying production traffic to localhost.
# API_INTERNAL_URL=http://api:4000

